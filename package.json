{
  "name": "@formio/ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:plugin": "tsx scripts/build-plugin.ts",
    "build:mcpb": "tsx scripts/build-mcpb.ts",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:plugin": "tsx scripts/test-plugin.ts",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release:get-tag": "node -p \"require('fs').existsSync('.changeset/pre.json')?require('./.changeset/pre.json').tag:'latest'\"",
    "release": "pnpm -r publish --tag $(pnpm -s release:get-tag)"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.24.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "turbo": "^2.9.18",
    "typescript-eslint": "^8.30.1"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  }
}
