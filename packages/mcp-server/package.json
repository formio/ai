{
  "name": "@formio/mcp",
  "version": "0.11.0",
  "mcpName": "io.form/formio-mcp",
  "description": "Form.io MCP Server",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "formio",
    "form.io",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "forms",
    "claude",
    "ai",
    "agent"
  ],
  "homepage": "https://github.com/formio/ai#readme",
  "bugs": {
    "url": "https://github.com/formio/ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formio/ai.git",
    "directory": "packages/mcp-server"
  },
  "main": "./dist/server.js",
  "bin": {
    "formio-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc",
    "dev": "tsx watch src/stdio.ts",
    "start": "node dist/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "express": "^4.21.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.17",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
