{
  "name": "@formio/mcp",
  "version": "1.0.0",
  "mcpName": "io.form/formio-mcp",
  "description": "Form.io MCP Server",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "formio",
    "form.io",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "forms",
    "claude",
    "ai",
    "agent"
  ],
  "homepage": "https://github.com/formio/ai#readme",
  "bugs": {
    "url": "https://github.com/formio/ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formio/ai.git",
    "directory": "packages/mcp-server"
  },
  "bin": {
    "formio-mcp": "./dist/stdio.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc",
    "dev": "tsx watch src/stdio.ts",
    "start": "node dist/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "tldts": "^7.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
