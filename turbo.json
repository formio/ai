{
  "$schema": "https://v2-11-5.turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    ".gitignore",
    "plugin/**",
    "scripts/**",
    "openspec/**",
    ".claude-plugin/marketplace.json",
    "server.json"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "typecheck": {},
    "clean": {
      "cache": false
    }
  }
}
