{
  "title": "Complex CRM",
  "description": "Multi-team CRM exercising transitive group access: Team is the group, Account is its direct child, and Contact/Deal/Activity are grandchildren whose access propagates through a hidden, calculated team mirror on each sub-resource form.",
  "version": "2.0.0",
  "name": "complexCrm",
  "roles": {
    "administrator": {
      "title": "Administrator",
      "description": "Full access to all resources; manages Teams and TeamUser memberships.",
      "admin": true,
      "default": false
    },
    "salesRep": {
      "title": "Sales Rep",
      "description": "Default role on self-registration. Access to Accounts, Contacts, Deals, and Activities is narrowed by TeamUser membership at runtime.",
      "admin": false,
      "default": false
    },
    "authenticated": {
      "title": "Authenticated",
      "description": "Baseline role issued by Login; salesRep is layered on top.",
      "admin": false,
      "default": false
    },
    "anonymous": {
      "title": "Anonymous",
      "description": "Unauthenticated visitors; may reach only login/register forms.",
      "admin": false,
      "default": true
    }
  },
  "forms": {
    "userRegister": {
      "title": "User Register",
      "type": "form",
      "name": "userRegister",
      "path": "user/register",
      "tags": [],
      "components": [
        {
          "type": "email",
          "key": "email",
          "label": "Email",
          "inputType": "email",
          "placeholder": "Enter your email address",
          "persistent": true,
          "unique": false,
          "protected": false,
          "input": true,
          "tableView": true
        },
        {
          "type": "password",
          "key": "password",
          "label": "Password",
          "inputType": "password",
          "placeholder": "Enter your password.",
          "persistent": true,
          "protected": true,
          "input": true,
          "tableView": false
        },
        {
          "type": "button",
          "key": "submit",
          "label": "Submit",
          "action": "submit",
          "theme": "primary",
          "disableOnInvalid": true,
          "input": true
        }
      ],
      "access": [
        {
          "type": "read_all",
          "roles": ["administrator", "anonymous", "authenticated"]
        }
      ],
      "submissionAccess": [
        {
          "type": "create_own",
          "roles": ["anonymous"]
        }
      ]
    },
    "userLogin": {
      "title": "User Login",
      "type": "form",
      "name": "userLogin",
      "path": "user/login",
      "tags": [],
      "components": [
        {
          "type": "email",
          "key": "email",
          "label": "Email",
          "inputType": "email",
          "placeholder": "Enter your email address",
          "persistent": true,
          "unique": false,
          "protected": false,
          "input": true,
          "tableView": true
        },
        {
          "type": "password",
          "key": "password",
          "label": "Password",
          "inputType": "password",
          "placeholder": "Enter your password.",
          "persistent": true,
          "protected": true,
          "input": true,
          "tableView": false
        },
        {
          "type": "button",
          "key": "submit",
          "label": "Submit",
          "action": "submit",
          "theme": "primary",
          "disableOnInvalid": true,
          "input": true
        }
      ],
      "access": [
        {
          "type": "read_all",
          "roles": ["administrator", "anonymous", "authenticated"]
        }
      ],
      "submissionAccess": [
        {
          "type": "create_own",
          "roles": ["anonymous"]
        }
      ]
    }
  },
  "actions": {
    "user:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "user",
      "priority": 10,
      "method": ["create", "update"],
      "handler": ["before"]
    },
    "userRegister:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "userRegister",
      "priority": 11,
      "method": ["create", "update"],
      "handler": ["before"],
      "settings": {
        "resource": "user",
        "fields": {
          "email": "email",
          "password": "password"
        }
      }
    },
    "userRegister:role": {
      "title": "Role Assignment",
      "name": "role",
      "form": "userRegister",
      "priority": 1,
      "method": ["create"],
      "handler": ["after"],
      "settings": {
        "association": "new",
        "type": "add",
        "role": "salesRep"
      }
    },
    "userRegister:login": {
      "title": "Login",
      "name": "login",
      "form": "userRegister",
      "priority": 2,
      "method": ["create"],
      "handler": ["before"],
      "settings": {
        "resources": ["user"],
        "username": "email",
        "password": "password"
      }
    },
    "userLogin:login": {
      "title": "Login",
      "name": "login",
      "form": "userLogin",
      "priority": 2,
      "method": ["create"],
      "handler": ["before"],
      "settings": {
        "resources": ["user"],
        "username": "email",
        "password": "password",
        "allowedAttempts": 5,
        "attemptWindow": 30,
        "lockWait": 1800
      }
    },
    "team:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "team",
      "priority": 10,
      "method": ["create", "update"],
      "handler": ["before"]
    },
    "teamUser:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "teamUser",
      "priority": 10,
      "method": ["create", "update"],
      "handler": ["before"]
    },
    "teamUser:group": {
      "title": "Group Assignment",
      "name": "group",
      "form": "teamUser",
      "priority": 5,
      "method": ["create", "update", "delete"],
      "handler": ["after"],
      "settings": {
        "group": "team",
        "user": "user"
      }
    },
    "account:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "account",
      "priority": 10,
      "method": ["create", "update"],
      "handler": ["before"]
    },
    "contact:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "contact",
      "priority": 10,
      "method": ["create", "update"],
      "handler": ["before"]
    },
    "deal:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "deal",
      "priority": 10,
      "method": ["create", "update"],
      "handler": ["before"]
    },
    "activity:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "activity",
      "priority": 10,
      "method": ["create", "update"],
      "handler": ["before"]
    }
  },
